# ---------------------------------------------------------------------
# ResolveX configuration. Copy this file to .env.local and fill it in.
# .env.local is ignored by git - never commit real passwords.
# ---------------------------------------------------------------------

# Superuser / owner connection, used ONLY by `npm run db:setup`
# (creates the database, tables, roles and loads data)
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/resolvex

# Least-privilege login the web app uses at runtime.
# db:setup creates this login and makes it a member of the resolvex_app role.
APP_DB_USER=resolvex_web
APP_DB_PASSWORD=CHANGE_ME_TOO
DATABASE_URL=postgresql://resolvex_web:CHANGE_ME_TOO@localhost:5432/resolvex

# --- MongoDB (document store: incident notes, inspection logs, search log) ---
# Root login, used ONLY by `npm run db:setup` (with Docker the password is mongo_dev_only
# unless you set MONGO_ROOT_PASSWORD)
MONGODB_ADMIN_URI=mongodb://root:mongo_dev_only@localhost:27017/?authSource=admin
# Least-privilege login the web app uses. db:setup creates it with the role resolvexAppRole.
MONGO_APP_USER=resolvex_app
MONGO_APP_PASSWORD=CHANGE_ME_THREE
MONGODB_URI=mongodb://resolvex_app:CHANGE_ME_THREE@localhost:27017/resolvex?authSource=resolvex

# Secret used to sign login sessions (JWT). Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Embedding model (downloaded once from Hugging Face into ./.model-cache, ~90 MB)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Optional: folder holding a local copy at <path>/Xenova/all-MiniLM-L6-v2 (for offline demos)
# EMBEDDING_MODEL_PATH=./models
# EMBEDDING_ALLOW_REMOTE=true

# Port clash with a local PostgreSQL or MongoDB? Put DB_PORT=5433 and/or MONGO_PORT=27018 in a
# file named .env (read by docker compose) and use those ports in the URLs above.
# Never edit docker-compose.yml.

# Set to false only if you demo over plain HTTP on a LAN with `npm start`
# COOKIE_SECURE=false
